<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixiaojiang.dao.UserMapper">

  <resultMap id="userAccount" type="com.zhixiaojiang.model.vo.UserAccount">
    <id column="id" property="id"/>
    <result column="username" property="username"/>
    <result column="display_name" property="displayName"/>
    <result column="role" property="role"/>
    <result column="password_hash" property="passwordHash"/>
  </resultMap>

  <select id="findByUsername" resultMap="userAccount">
    select id, username, display_name, role, password_hash
    from sys_user
    where username = #{username}
  </select>

  <select id="findById" resultMap="userAccount">
    select id, username, display_name, role
    from sys_user
    where id = #{id}
  </select>

  <update id="updateDisplayName">
    update sys_user set display_name = #{displayName}
    where id = #{id} and display_name = #{previousDisplayName}
  </update>
</mapper>
