<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zhixiaojiang.dao.ClassRoomMapper">

  <resultMap id="classSummary" type="com.zhixiaojiang.model.vo.ClassSummary">
    <id column="id" property="id"/>
    <result column="name" property="name"/>
    <result column="grade" property="grade"/>
    <result column="is_demo" property="isDemo"/>
    <result column="student_count" property="studentCount"/>
  </resultMap>

  <select id="ofTeacher" resultMap="classSummary">
    select c.id, c.name, c.grade, c.is_demo,
           (select count(*) from student s where s.class_id = c.id and s.status = 'ACTIVE') as student_count
    from class_room c
    where c.teacher_id = #{teacherId}
    order by c.id
  </select>
</mapper>
