# 应用运行口令：复制为 /opt/zhixiaojiang/app.env（chmod 600），不要提交到版本库。
# 变量名在这里固定下来，值由部署环境注入；数据库与 Redis 口令需与服务器上的
# MySQL/Redis 容器一致（见 /opt/zhixiaojiang/mysql.env 与 redis 配置）。
DB_PASSWORD=
REDIS_PASSWORD=
# JWT 签名密钥：至少 32 位随机字符。上线后更换会让所有人重新登录
JWT_SECRET=
# 可选：接入 OpenAI 兼容模型服务；留空时助手降级为规则模板
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
